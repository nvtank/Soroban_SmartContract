# Chỉ biến NEXT_PUBLIC_* được lộ xuống trình duyệt. Không commit file .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Thanh toán: payos | simulated | both
PAYMENT_MODE=both
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Số tiền VND thu thử nghiệm ở chế độ payOS. Kiểm tra mức tối thiểu trong tài liệu payOS.
DEMO_PAYMENT_AMOUNT=2000

# Custody: tạo bằng `openssl rand -base64 32`. Bản thật cần HSM/KMS.
CUSTODY_MASTER_KEY=
CUSTODY_KEY_VERSION=1

# Stellar Testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_EXPLORER_TX_URL=https://stellar.expert/explorer/testnet/tx
STELLAR_CONTRACT_ID=
STELLAR_ADMIN_SECRET=
STELLAR_PLATFORM_SECRET=
STELLAR_ORACLE_SECRET=

# Passkey (WebAuthn): phải khớp domain đang chạy
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RentFlow
WEBAUTHN_ORIGIN=http://localhost:3000
